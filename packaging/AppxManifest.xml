<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparse package that gives QuickClip an identity so its Explorer menu entry shows on Windows 11's main menu.
  It holds no program files: QuickClip.exe and QuickClipShell.dll stay in the install folder (the external location).
  The file types below must match ShellIntegration.Extensions (a test checks this).
-->
