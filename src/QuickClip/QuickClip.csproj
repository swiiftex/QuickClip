<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets\QuickClip.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.4.0</Version>
    <Product>QuickClip</Product>
    <!-- Fluent theme (ThemeMode) is still flagged as experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <DepsDir>$(MSBuildThisFileDirectory)..\..\deps\</DepsDir>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\QuickClip.ico" />
    <InternalsVisibleTo Include="QuickClip.Tests" />
  </ItemGroup>

  <!-- Native recording engine (C++), rebuilt when its sources change. Needs Visual Studio's C++ tools;
       without them the app still builds, just without recording. -->
  <PropertyGroup>
    <CaptureEngineDir>$(MSBuildThisFileDirectory)..\QuickClip.Capture\</CaptureEngineDir>
    <CaptureEngineDll>$(CaptureEngineDir)bin\QuickClipCapture.dll</CaptureEngineDll>
  </PropertyGroup>
  <ItemGroup>
    <CaptureEngineSource Include="$(CaptureEngineDir)*.cpp;$(CaptureEngineDir)*.h" />
  </ItemGroup>
  <Target Name="BuildCaptureEngine" BeforeTargets="BeforeBuild" Inputs="@(CaptureEngineSource)" Outputs="$(CaptureEngineDll)">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\build-capture.ps1&quot;" ContinueOnError="true" />
  </Target>
  <Target Name="IncludeCaptureEngine" AfterTargets="BuildCaptureEngine">
    <ItemGroup Condition="Exists('$(CaptureEngineDll)')">
      <None Include="$(CaptureEngineDll)" Link="QuickClipCapture.dll" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- Native dependencies fetched by scripts/get-deps.ps1 -->
  <ItemGroup>
    <None Include="$(DepsDir)libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(DepsDir)libmpv-2.dll')" />
    <None Include="$(DepsDir)ffmpeg\**\*" Link="ffmpeg\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
