<Window x:Class="QuickClip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:QuickClip.Views"
        Title="QuickClip"
        Width="1360" Height="900" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/QuickClip.ico">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuickClip;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navigation -->
        <DockPanel Grid.RowSpan="2" Background="{StaticResource RailBrush}">
            <Image DockPanel.Dock="Top" Source="Assets/QuickClip.ico" Width="30" Height="30" Margin="0,16,0,14" />
            <StackPanel DockPanel.Dock="Top">
                <RadioButton x:Name="GalleryNav" Style="{StaticResource RailItem}" Tag="&#xE8A9;" Content="Gallery" GroupName="Nav"
                             IsChecked="True" Checked="Nav_Checked" ToolTip="Your clips" />
                <RadioButton x:Name="EditorNav" Style="{StaticResource RailItem}" Tag="&#xE70F;" Content="Editor" GroupName="Nav"
                             Checked="Nav_Checked" ToolTip="Trim, crop and export a clip" />
                <RadioButton x:Name="SettingsNav" Style="{StaticResource RailItem}" Tag="&#xE713;" Content="Settings" GroupName="Nav"
                             Checked="Nav_Checked" ToolTip="Recording, audio, hotkey and startup" />
            </StackPanel>
            <Grid />
        </DockPanel>

        <!-- Pages: the editor is created the first time it's needed and then kept (its video window must persist) -->
        <Grid x:Name="Pages" Grid.Column="1">
            <views:GalleryView x:Name="Gallery" />
        </Grid>

        <!-- Recording status -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="16,7,10,7">
            <DockPanel>
                <Button x:Name="SaveClipButton" DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" Padding="12,5" Focusable="False"
                        Click="SaveClip_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7C8;" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock x:Name="SaveClipText" Text="Save clip" />
                    </StackPanel>
                </Button>
                <Button x:Name="UpdateButton" DockPanel.Dock="Right" Style="{StaticResource TextButton}" Margin="0,0,8,0" Padding="10,4"
                        Visibility="Collapsed" Click="UpdateButton_Click" ToolTip="A new version of QuickClip is available">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" VerticalAlignment="Center" Margin="0,0,7,0"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="UpdateButtonText" Text="Update available" />
                    </StackPanel>
                </Button>
                <Ellipse x:Name="RecDot" DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center" Fill="#666" />
                <TextBlock x:Name="RecStatus" VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis" Text="Starting…" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
