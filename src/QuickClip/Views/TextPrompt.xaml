<Window x:Class="QuickClip.Views.TextPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickClip" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary Source="/QuickClip;component/Themes/Styles.xaml" />
    </Window.Resources>
    <StackPanel Margin="22,18,22,20">
        <TextBlock x:Name="PromptText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" />
        <TextBox x:Name="Input" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton" Style="{DynamicResource AccentButtonStyle}" MinWidth="96" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" MinWidth="96" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
