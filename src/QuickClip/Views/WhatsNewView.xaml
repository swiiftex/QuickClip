<UserControl x:Class="QuickClip.Views.WhatsNewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="/QuickClip;component/Themes/Styles.xaml" />
    </UserControl.Resources>

    <!-- Over the whole window; the dimmed background keeps clicks off the pages underneath -->
    <Grid Background="#B0000000">
        <Border Background="{StaticResource PanelBrush}" CornerRadius="10" BorderBrush="#383838" BorderThickness="1"
                MaxWidth="700" MaxHeight="660" Margin="40" Padding="28,22,28,18" HorizontalAlignment="Center" VerticalAlignment="Center">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE789;" FontSize="20" VerticalAlignment="Center" Margin="0,2,10,0"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" Text="What's new" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" Content="Got it" Padding="22,6" Click="Close_Click" />
                    <Button x:Name="PageButton" DockPanel.Dock="Left" Style="{StaticResource TextButton}" Click="Page_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A7;" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Release page" />
                        </StackPanel>
                    </Button>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,-12,0" Padding="0,0,12,0">
                    <StackPanel x:Name="Notes" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
