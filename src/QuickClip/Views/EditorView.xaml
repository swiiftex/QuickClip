<UserControl x:Class="QuickClip.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QuickClip"
             xmlns:controls="clr-namespace:QuickClip.Controls"
             AllowDrop="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuickClip;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <GridLength x:Key="TrackHeaderWidth">260</GridLength>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Root" Margin="12" Focusable="True" FocusVisualStyle="{x:Null}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10" LastChildFill="True">
            <Button DockPanel.Dock="Left" Style="{StaticResource TextButton}" Click="Open_Click" ToolTip="Open a file (Ctrl+O)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8E5;" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Open" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE765;" Margin="4,0,0,0">
                <Button.ToolTip>
                    <TextBlock LineHeight="20">
                        <Bold>Keyboard shortcuts</Bold><LineBreak />
                        Space — play / pause<LineBreak />
                        ← / → — previous / next frame<LineBreak />
                        Shift+← / → — 1 second · Ctrl+← / → — 5 seconds<LineBreak />
                        I / O — set in / out at the playhead<LineBreak />
                        Shift+I / Shift+O — jump to in / out<LineBreak />
                        Home / End — start / end of file<LineBreak />
                        L — loop selection · C — crop on/off · M — mute<LineBreak />
                        + / − / 0 — zoom timeline in / out / fit<LineBreak />
                        Mouse wheel on timeline — zoom · Shift+wheel — scroll<LineBreak />
                        Ctrl+E — export as new file · Ctrl+S — save over original
                    </TextBlock>
                </Button.ToolTip>
            </Button>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="FileNameText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="No file open" />
                <TextBlock x:Name="FileInfoText" FontSize="12" Foreground="{StaticResource SubtleText}" TextTrimming="CharacterEllipsis"
                           Text="Open a video or audio file, or drop one onto this window." />
            </StackPanel>
        </DockPanel>

        <!-- Video -->
        <Border Grid.Row="1" Grid.Column="0" Background="Black">
            <controls:VideoHost x:Name="Video" />
        </Border>

        <!-- Transport (the editing controls move to a second line when the window is too narrow for one) -->
        <Grid x:Name="Transport" Grid.Row="2" Grid.Column="0" Margin="0,10,0,8" SizeChanged="Transport_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="PlaybackControls" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left"
                        SizeChanged="Transport_SizeChanged">
                <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="GoStart_Click" ToolTip="Go to start (Home)" />
                <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Click="FrameBack_Click" ToolTip="Previous frame (←)" />
                <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;" Click="Play_Click" ToolTip="Play / pause (Space)" Padding="16,6" />
                <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Click="FrameForward_Click" ToolTip="Next frame (→)" />
                <Button Style="{StaticResource IconButton}" Content="&#xE893;" Click="GoEnd_Click" ToolTip="Go to end (End)" />
                <TextBlock x:Name="TimeText" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="15" Text="0:00.000" />
                <TextBlock x:Name="DurationText" VerticalAlignment="Center" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource SubtleText}" Text=" / 0:00.000" />
                <controls:AppVolumeControl x:Name="Volume" Margin="14,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="EditControls" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button Style="{StaticResource TextButton}" Click="SetIn_Click" Content="Set in" ToolTip="Start the clip at the playhead (I)" />
                <Button Style="{StaticResource TextButton}" Click="SetOut_Click" Content="Set out" ToolTip="End the clip at the playhead (O)" />
                <ToggleButton x:Name="LoopToggle" Style="{StaticResource IconToggle}" Margin="8,0,12,0" Checked="Loop_Changed" Unchecked="Loop_Changed"
                              ToolTip="Loop the selection while previewing (L)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8EE;" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Loop" />
                    </StackPanel>
                </ToggleButton>
                <Button Style="{StaticResource IconButton}" Content="&#xE71F;" Click="ZoomOut_Click" ToolTip="Zoom timeline out (−)" />
                <Button Style="{StaticResource IconButton}" Content="&#xE9A6;" Click="ZoomFit_Click" ToolTip="Show the whole file (0)" />
                <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" Click="ZoomIn_Click" ToolTip="Zoom timeline in (+)" Margin="0" />
            </StackPanel>
        </Grid>

        <!-- Timeline + audio tracks -->
        <Grid Grid.Row="3" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource TrackHeaderWidth}" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- In / out editor -->
            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="8,4">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="In" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource SubtleText}" FontSize="12" />
                    <TextBox x:Name="InBox" Grid.Column="1" Style="{StaticResource CompactBox}" FontFamily="Consolas" Text="0:00.000"
                             KeyDown="TimeBox_KeyDown" LostKeyboardFocus="InBox_Commit" ToolTip="Clip start (type a time like 1:23.5)" />
                    <TextBlock Grid.Column="2" Text="Out" VerticalAlignment="Center" Margin="8,0,6,0" Foreground="{StaticResource SubtleText}" FontSize="12" />
                    <TextBox x:Name="OutBox" Grid.Column="3" Style="{StaticResource CompactBox}" FontFamily="Consolas" Text="0:00.000"
                             KeyDown="TimeBox_KeyDown" LostKeyboardFocus="OutBox_Commit" ToolTip="Clip end (type a time like 1:23.5)" />
                    <TextBlock x:Name="SelectionText" Grid.Row="1" Grid.ColumnSpan="4" Margin="0,3,0,0" FontSize="11.5"
                               Foreground="{StaticResource SubtleText}" Text="Clip length 0:00.000" />
                </Grid>
            </Border>
            <controls:TimelineBar x:Name="Timeline" Grid.Row="0" Grid.Column="2" Height="56" />

            <!-- Audio header -->
            <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,2">
                <CheckBox x:Name="MergeCheck" DockPanel.Dock="Right" Content="Merge all tracks into one when exporting" Checked="Merge_Changed" Unchecked="Merge_Changed"
                          ToolTip="Mix every checked track (at its volume) into a single audio track in the exported file." />
                <TextBlock x:Name="AudioHeader" Text="AUDIO TRACKS" Style="{StaticResource SectionHeader}" Margin="2,0,0,0" VerticalAlignment="Center" />
            </DockPanel>

            <ScrollViewer Grid.Row="2" Grid.ColumnSpan="3" MaxHeight="250" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="TrackList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:AudioTrack}">
                            <Grid Height="74" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource TrackHeaderWidth}" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource PanelBrush}" CornerRadius="4" BorderThickness="3,0,0,0" BorderBrush="{Binding Brush}" Padding="6,4,6,2">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Include}" VerticalAlignment="Center" Margin="0,0,-4,0" MinHeight="0"
                                                  ToolTip="Include this track in the export" />
                                        <TextBox Grid.Column="1" Style="{StaticResource CompactBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{Binding Description}" VerticalAlignment="Center" />
                                        <ToggleButton Grid.Column="2" IsChecked="{Binding Solo}" Margin="4,0,0,0" Padding="7,3" MinWidth="0" MinHeight="0"
                                                      Focusable="False" FontSize="12" Content="Solo" VerticalAlignment="Center"
                                                      ToolTip="Preview only this track (doesn't affect the export)" />
                                        <Grid Grid.Row="1" Grid.ColumnSpan="3" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="92" />
                                            </Grid.ColumnDefinitions>
                                            <Slider Minimum="0" Maximum="200" Value="{Binding VolumePercent}" SmallChange="1" LargeChange="10"
                                                    Focusable="False" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                                    MouseDoubleClick="VolumeSlider_DoubleClick" ToolTip="Volume (double-click for 100%)" />
                                            <TextBlock Grid.Column="1" Text="{Binding VolumeText}" FontSize="11" Foreground="{StaticResource SubtleText}"
                                                       VerticalAlignment="Center" TextAlignment="Right" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <controls:WaveformLane Grid.Column="2" Track="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Side panel -->
        <Border Grid.Row="0" Grid.RowSpan="4" Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16,6,16,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock x:Name="SummaryText" FontSize="12" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,10,0,10" />
                    <Button x:Name="ExportButton" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="10,9" Focusable="False"
                            Click="ExportNew_Click" ToolTip="Export the selection to a new file (Ctrl+E)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE792;" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Export as new file…" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveOverButton" HorizontalAlignment="Stretch" Padding="10,8" Margin="0,8,0,0" Focusable="False"
                            Click="SaveOver_Click" ToolTip="Replace the original file with the edited clip (Ctrl+S). The original goes to the Recycle Bin.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74E;" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Save over original" />
                        </StackPanel>
                    </Button>
                    <Grid x:Name="ProgressPanel" Margin="0,12,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="ExportProgress" Minimum="0" Maximum="100" Height="6" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" Margin="8,0,0,0" Padding="6,4" FontSize="11"
                                Click="CancelExport_Click" ToolTip="Cancel export" />
                    </Grid>
                    <DockPanel Margin="0,8,0,0">
                        <Button x:Name="RevealButton" DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="Show" Margin="6,0,0,0" Padding="9,3"
                                Visibility="Collapsed" Click="Reveal_Click" ToolTip="Show the exported file in Explorer" />
                        <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource SubtleText}" />
                    </DockPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-10,0" Padding="0,0,10,0">
                    <StackPanel>
                        <!-- Crop -->
                        <StackPanel x:Name="CropSection">
                            <TextBlock Text="CROP" Style="{StaticResource SectionHeader}" Margin="0,8,0,4" />
                            <CheckBox x:Name="CropCheck" Content="Crop video" Checked="Crop_Changed" Unchecked="Crop_Changed" ToolTip="Toggle cropping (C)" />
                            <TextBlock x:Name="CropHint" FontSize="11.5" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="Drag on the video to draw the area to keep. Drag edges or corners to resize, or inside to move." />
                            <StackPanel x:Name="CropPanel" IsEnabled="False">
                                <TextBlock Text="Aspect ratio" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="AspectCombo" SelectionChanged="Aspect_Changed" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="6" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="W" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource SubtleText}" />
                                    <TextBox x:Name="CropW" Grid.Column="1" Style="{StaticResource CompactBox}" KeyDown="CropBox_KeyDown" LostKeyboardFocus="CropBox_Commit" />
                                    <TextBlock Grid.Column="2" Text="H" VerticalAlignment="Center" Margin="10,0,6,0" Foreground="{StaticResource SubtleText}" />
                                    <TextBox x:Name="CropH" Grid.Column="3" Style="{StaticResource CompactBox}" KeyDown="CropBox_KeyDown" LostKeyboardFocus="CropBox_Commit" />
                                    <TextBlock Grid.Row="2" Text="X" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource SubtleText}" />
                                    <TextBox x:Name="CropX" Grid.Row="2" Grid.Column="1" Style="{StaticResource CompactBox}" KeyDown="CropBox_KeyDown" LostKeyboardFocus="CropBox_Commit" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Y" VerticalAlignment="Center" Margin="10,0,6,0" Foreground="{StaticResource SubtleText}" />
                                    <TextBox x:Name="CropY" Grid.Row="2" Grid.Column="3" Style="{StaticResource CompactBox}" KeyDown="CropBox_KeyDown" LostKeyboardFocus="CropBox_Commit" />
                                </Grid>
                                <Button Style="{StaticResource TextButton}" Content="Reset crop" Margin="0,8,0,0" HorizontalAlignment="Left" Click="CropReset_Click" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Export -->
                        <TextBlock Text="EXPORT" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="Format" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                        <ComboBox x:Name="FormatCombo" SelectionChanged="ExportOption_Changed" />

                        <StackPanel x:Name="VideoOptions">
                            <TextBlock Text="Video" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="VideoModeCombo" SelectionChanged="ExportOption_Changed" />
                            <StackPanel x:Name="EncodeOptions">
                                <TextBlock Text="Encoder" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="EncoderCombo" SelectionChanged="ExportOption_Changed" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Resolution" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ResolutionCombo" SelectionChanged="ExportOption_Changed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Frame rate" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="FpsCombo" SelectionChanged="ExportOption_Changed" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="QualityOptions">
                                <TextBlock Text="Quality" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="QualityCombo" SelectionChanged="ExportOption_Changed" />
                            </StackPanel>
                            <StackPanel x:Name="AudioOptions" Grid.Column="2">
                                <TextBlock Text="Audio bitrate" Style="{StaticResource FieldLabel}"
                                           ToolTip="Used when audio has to be re-encoded (volume changed, tracks merged or a different format)" />
                                <ComboBox x:Name="AudioBitrateCombo" SelectionChanged="ExportOption_Changed" />
                            </StackPanel>
                        </Grid>
                        <DockPanel x:Name="TargetSizePanel" Margin="0,6,0,0" Visibility="Collapsed">
                            <TextBlock DockPanel.Dock="Right" Text="MB" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource SubtleText}" />
                            <TextBlock DockPanel.Dock="Left" Text="Target size" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource SubtleText}" FontSize="12" />
                            <TextBox x:Name="TargetSizeBox" Style="{StaticResource CompactBox}" TextChanged="TargetSize_Changed"
                                     ToolTip="Aim for this file size, e.g. 10 for Discord's free upload limit" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
