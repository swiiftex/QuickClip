<UserControl x:Class="QuickClip.Views.GalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gallery="clr-namespace:QuickClip.Gallery">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuickClip;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="ClipCard" DataType="{x:Type gallery:ClipItem}">
                <Border x:Name="Card" Width="264" Margin="0,0,14,16" CornerRadius="8" Background="{StaticResource CardBrush}"
                        BorderThickness="1" BorderBrush="Transparent" Cursor="Hand" ToolTip="{Binding Title}"
                        MouseLeftButtonDown="Card_MouseLeftButtonDown" Loaded="Card_Loaded" DataContextChanged="Card_DataContextChanged">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open in editor" Click="OpenClip_Click" FontWeight="SemiBold" />
                            <MenuItem Header="Play" Click="PlayClip_Click" />
                            <MenuItem Header="Show in Explorer" Click="RevealClip_Click" />
                            <Separator />
                            <MenuItem Header="Delete" Click="DeleteClip_Click" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel>
                        <Grid Height="148">
                            <Border CornerRadius="7,7,0,0" Background="#111" />
                            <Border CornerRadius="7,7,0,0">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="7" Padding="6,1,6,2" CornerRadius="4"
                                    Background="#B0000000">
                                <TextBlock Text="{Binding DurationText}" FontSize="11.5" Foreground="White" />
                            </Border>
                        </Grid>
                        <StackPanel Margin="11,8,11,10">
                            <TextBlock Text="{Binding Folder}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource SubtleText}">
                                <Run Text="{Binding Ago, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding SizeText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Folders: "All clips" first, then a folder per game -->
        <Border Background="{StaticResource PanelBrush}">
            <DockPanel Margin="10,6,10,10">
                <TextBlock DockPanel.Dock="Top" Text="FOLDERS" Style="{StaticResource SectionHeader}" Margin="8,14,0,8" />
                <ListBox x:Name="FolderList" SelectionChanged="FolderList_SelectionChanged" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{StaticResource SubtleText}" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Clips -->
        <DockPanel Grid.Column="1" Margin="24,18,10,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,14,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource TextButton}" Click="OpenFolder_Click" ToolTip="Open this folder in Explorer">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE838;" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Open folder" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TextButton}" Click="OpenFile_Click" ToolTip="Edit any video or audio file">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8E5;" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Open file…" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="FolderTitle" Text="All clips" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="FolderInfo" Margin="0,2,0,0" Style="{StaticResource Hint}" />
                </StackPanel>
            </DockPanel>

            <Grid x:Name="ClipArea" SizeChanged="ClipArea_SizeChanged">
                <ItemsControl x:Name="Rows" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource ClipCard}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="0,0,0,80"
                            Visibility="Collapsed">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE714;" FontSize="40" HorizontalAlignment="Center"
                               Foreground="{StaticResource SubtleText}" />
                    <TextBlock x:Name="EmptyTitle" Text="No clips yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,6" />
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Hint}" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
